rules_version = '2';

// All Firestore access goes through the Next.js server using the Firebase
// Admin SDK, which bypasses these rules. Browsers get no direct access at all,
// so the public web config can't be used to read or modify anyone's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
