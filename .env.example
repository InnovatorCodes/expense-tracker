# Copy to .env.local and fill in. Never commit real values.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- MongoDB (user accounts, via Prisma) ---
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DB_NAME"

# --- Firebase Admin (server-side Firestore access) ---
# Uses a service account, NOT the deprecated "Database secrets".
# Firebase console > Project settings > Service accounts > "Firebase Admin SDK"
# tab > Generate new private key. That downloads a JSON file. Use ONE option:
#
# Option 1 (recommended): paste the whole JSON file on one line, or base64 it:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   macOS/Linux: base64 -w0 key.json
FIREBASE_SERVICE_ACCOUNT_KEY=""
#
# Option 2: copy three fields from the JSON file. Keep the private key on one
# line with \n escapes, wrapped in double quotes.
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Option 3: point at the JSON file on disk (local development only).
# GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/key.json"

# --- Exchange rates (server-only; https://www.exchangerate-api.com) ---
EXCHANGE_RATES_API_KEY=""
