# Copy to .env.local and fill in. Never commit real values.

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- MongoDB (user accounts, via Prisma) ---
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DB_NAME"

# --- Firebase Admin (server-side Firestore access) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the private key on one line with \n escapes, wrapped in double quotes.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Exchange rates (server-only; https://www.exchangerate-api.com) ---
EXCHANGE_RATES_API_KEY=""
